generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DB_CONNECTION_STRING")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Pax {
  id          String     @id @default(cuid())
  firstname   String
  lastname    String
  dni         String?
  dniVto      DateTime?
  passport    String?
  passportVto DateTime?
  dob         DateTime?
  adress      String?
  email       String?    @unique
  phoneNumber String?
  obs         String?    @db.VarChar(300)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  File        File[]     @relation("FilePax")
  photos      PaxPhoto[]
  pdfs        PaxPdf[]
}

model File {
  id                String    @id @default(cuid())
  // Automatic correlative number per year of creation, shown as "55-2026"
  numero            Int?
  anio              Int?
  // Free optional reference (shown as "Referencia" in the app)
  nro               String?
  obs               String?   @db.VarChar(300)
  precioNetoTotal   String
  tarifaTotal       String
  tarifaAlternativa String?
  destino           String
  fechaSalida       DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  clients           Pax[]     @relation("FilePax")
  services          Service[] @relation("FileService")
  pdfs              FilePdf[]

  @@unique([anio, numero])
}

model Service {
  id          String      @id @default(cuid())
  nombre      String
  provider    String
  localizador String?
  precioNeto  String
  tarifa      String
  currency    Currency
  type        ServiceType @default(AEREO)
  obs         String?     @db.VarChar(300)
  fechaInicio DateTime?
  fechaFin    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  deleted_at  DateTime?
  File        File[]      @relation("FileService")
}

enum Currency {
  USD
  PESOS
  EURO
}

enum ServiceType {
  AEREO
  HOTEL
  EXCURSION
  TRASLADO
}

model PaxPhoto {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimetype  String?
  size      Int?
  paxId     String
  pax       Pax      @relation(fields: [paxId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([paxId])
}

model PaxPdf {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  paxId        String
  pax          Pax      @relation(fields: [paxId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([paxId])
}

model FilePdf {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  fileId       String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([fileId])
}
