generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DB_CONNECTION_STRING")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Pax {
  id           String            @id @default(cuid())
  firstname    String
  lastname     String
  dni          String?
  dniVto       DateTime?
  passport     String?
  passportVto  DateTime?
  // US visa (number and expiry): needed for trips to the United States
  visaUsa      String?
  visaUsaVto   DateTime?
  dob          DateTime?
  adress       String?
  email        String?           @unique
  phoneNumber  String?
  obs          String?           @db.VarChar(300)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  File         File[]            @relation("FilePax")
  photos       PaxPhoto[]
  pdfs         PaxPdf[]
  // Payments this pax made (shown as payer on receipts)
  pagosHechos  FilePago[]
  // Rooms of group departures this pax sleeps in
  habitaciones GrupoHabitacion[] @relation("HabitacionPax")
}

model File {
  id                      String          @id @default(cuid())
  // Automatic correlative number per year of creation, shown as "55-2026"
  numero                  Int?
  anio                    Int?
  // Free optional reference (shown as "Referencia" in the app)
  nro                     String?
  obs                     String?         @db.VarChar(300)
  precioNetoTotal         String
  tarifaTotal             String
  // Price actually charged to the client (decided by the agency), in a single currency
  tarifaAlternativa       String?
  tarifaAlternativaMoneda Currency?
  destino                 String
  fechaSalida             DateTime
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  clients                 Pax[]           @relation("FilePax")
  services                Service[]       @relation("FileService")
  pdfs                    FilePdf[]
  // Client payments. While planPersonalizado is false the plan is the automatic one
  // (deposit = flights, balance 25 days before departure) and cuotas is not used
  planPersonalizado       Boolean         @default(false)
  cuotas                  FileCuota[]
  pagos                   FilePago[]
  // Invoiced to the client: the whole file at once (usually when fully paid). Amount and
  // currency are kept as invoiced, even if services change later
  facturadoAt             DateTime?
  facturaNumero           String?         @db.VarChar(50)
  facturaImporte          Decimal?        @db.Decimal(14, 2)
  facturaMoneda           Currency?
  // Reservation of a group departure (no file number; destino = "<group> · <reservation>")
  grupoId                 String?
  grupo                   Grupo?          @relation(fields: [grupoId], references: [id])
  reservaNombre           String?
  // Room type of the reservation (hotels priced by room type use it)
  habitacionTipo          HabitacionTipo?
  grupoPlanId             String?
  grupoPlan               GrupoPlan?      @relation(fields: [grupoPlanId], references: [id], onDelete: SetNull)

  @@unique([anio, numero])
  @@index([grupoId])
}

// Installment of a file's payment plan, in the file's charge currency
model FileCuota {
  id          String    @id @default(cuid())
  fileId      String
  file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  concepto    String
  importe     Decimal   @db.Decimal(14, 2)
  vencimiento DateTime
  // Group reservations charge each currency apart: which part this installment belongs to
  moneda      Currency?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([fileId])
}

// Payment received from the client. It can be made in another currency: then
// tipoCambio is used and importeAplicado is what it covers in the file's charge currency
model FilePago {
  id              String        @id @default(cuid())
  fileId          String
  file            File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fecha           DateTime
  importe         Decimal       @db.Decimal(14, 2)
  moneda          Currency
  tipoCambio      Decimal?      @db.Decimal(14, 4)
  importeAplicado Decimal       @db.Decimal(14, 2)
  // Group reservations: which currency part it pays (importeAplicado is in that currency)
  monedaAplicada  Currency?
  medio           PaymentMethod
  nota            String?       @db.VarChar(300)
  // Who paid (one of the file's pax); goes on the receipt
  pagadorId       String?
  pagador         Pax?          @relation(fields: [pagadorId], references: [id], onDelete: SetNull)
  recibo          Recibo?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([fileId])
}

// Receipt number of a client payment (sequential, given when the payment is registered)
model Recibo {
  numero    Int      @id @default(autoincrement())
  pagoId    String   @unique
  pago      FilePago @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

model Service {
  id               String                  @id @default(cuid())
  nombre           String
  provider         String
  localizador      String?
  precioNeto       String
  tarifa           String
  currency         Currency
  type             ServiceType             @default(AEREO)
  obs              String?                 @db.VarChar(300)
  fechaInicio      DateTime?
  fechaFin         DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt
  deleted_at       DateTime?
  // Sent to the wholesaler for settlement ("liquidado"); if not, the booking can be cancelled
  liquidado        Boolean                 @default(false)
  liquidadoAt      DateTime?
  // Deadline to settle it; null = default (1 month before departure)
  fechaLiquidacion DateTime?
  // Photos or PDFs (e.g. the flight itinerary)
  adjuntos         ServiceAdjunto[]
  File             File[]                  @relation("FileService")
  // Parts of payments to the wholesaler that cover this service (its net price)
  pagosMayorista   PagoMayoristaServicio[]
  // Line of a group reservation: the group service it comes from
  grupoServicioId  String?
  grupoServicio    GrupoServicio?          @relation(fields: [grupoServicioId], references: [id], onDelete: SetNull)
}

// Photo or document attached to a service (private file in Cloudinary)
model ServiceAdjunto {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([serviceId])
}

// Payment the agency makes to a wholesaler. One payment can cover services of several
// files (e.g. USD 10.000 = flights of one file + hotels of another); always in one currency
model PagoMayorista {
  id           String                  @id @default(cuid())
  fecha        DateTime
  mayorista    String
  importe      Decimal                 @db.Decimal(14, 2)
  moneda       Currency
  medio        PaymentMethod
  nota         String?                 @db.VarChar(300)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  aplicaciones PagoMayoristaServicio[]
}

// How much of a wholesaler payment goes to each service
model PagoMayoristaServicio {
  id        String        @id @default(cuid())
  pagoId    String
  pago      PagoMayorista @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  importe   Decimal       @db.Decimal(14, 2)

  @@index([pagoId])
  @@index([serviceId])
}

enum Currency {
  USD
  PESOS
  EURO
}

enum ServiceType {
  AEREO
  HOTEL
  EXCURSION
  TRASLADO
}

model PaxPhoto {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimetype  String?
  size      Int?
  paxId     String
  pax       Pax      @relation(fields: [paxId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([paxId])
}

model PaxPdf {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  paxId        String
  pax          Pax      @relation(fields: [paxId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([paxId])
}

model FilePdf {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  fileId       String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([fileId])
}

// Group departure: a trip sold per person. Each reservation (family, couple...) is a File
model Grupo {
  id           String            @id @default(cuid())
  titulo       String
  destino      String
  fechaSalida  DateTime
  fechaRegreso DateTime?
  // Seats; null = no limit
  cupo         Int?
  // Trip to the US: every pax needs a valid US visa
  visaUsa      Boolean           @default(false)
  obs          String?           @db.VarChar(500)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  servicios    GrupoServicio[]
  planes       GrupoPlan[]
  reservas     File[]
  habitaciones GrupoHabitacion[]
  pdfs         GrupoPdf[]
}

// Service of the group itinerary with its list price per passenger (each reservation copies it
// and can change the price, e.g. presale)
model GrupoServicio {
  id                String      @id @default(cuid())
  grupoId           String
  grupo             Grupo       @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  type              ServiceType @default(AEREO)
  nombre            String
  provider          String
  currency          Currency
  netoPorPax        Decimal     @db.Decimal(14, 2)
  tarifaPorPax      Decimal     @db.Decimal(14, 2)
  // How it's priced: POR_PASAJERO (optionally cheaper for children), POR_RESERVA (one price per
  // reservation, e.g. a car per family) or POR_HABITACION (per person by room type, e.g. hotels)
  modoPrecio        String      @default("POR_PASAJERO")
  // Children under edadMenor (at departure) pay netoMenor/tarifaMenor
  edadMenor         Int?
  netoMenor         Decimal?    @db.Decimal(14, 2)
  tarifaMenor       Decimal?    @db.Decimal(14, 2)
  // POR_HABITACION: { SINGLE: { neto, tarifa }, DOBLE: {...}, ... } per person
  preciosHabitacion Json?
  fechaInicio       DateTime?
  fechaFin          DateTime?
  fechaLiquidacion  DateTime?
  createdAt         DateTime    @default(now())
  servicios         Service[]

  @@index([grupoId])
}

// Payment plan of a group (e.g. "Preventa"): installments as % of each reservation's total
// (in each currency) with a due date; the last one with porcentaje null is the balance
model GrupoPlan {
  id        String   @id @default(cuid())
  grupoId   String
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre    String
  // [{ concepto, porcentaje (null = saldo), vencimiento }]
  cuotas    Json
  createdAt DateTime @default(now())
  reservas  File[]

  @@index([grupoId])
}

enum HabitacionTipo {
  SINGLE
  DOBLE
  TRIPLE
  CUADRUPLE
}

// Rooming: a room of the group and who sleeps in it
model GrupoHabitacion {
  id        String         @id @default(cuid())
  grupoId   String
  grupo     Grupo          @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  tipo      HabitacionTipo
  obs       String?        @db.VarChar(200)
  pasajeros Pax[]          @relation("HabitacionPax")
  createdAt DateTime       @default(now())

  @@index([grupoId])
}

model GrupoPdf {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  mimetype     String?
  size         Int?
  grupoId      String
  grupo        Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([grupoId])
}
